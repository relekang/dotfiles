{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(gh-resolve-review-thread:*)",
      "Bash(grep:*)",
      "Bash(jj diff:*)",
      "Bash(jj log:*)",
      "Bash(jj new:*)",
      "Bash(jj status:*)",
      "Bash(mise t:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/rolf/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash '/Users/rolf/.claude/statusline-command.sh'"
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
