{{ if has "packages" ((index .chezmoi "tags") | default (list)) }}#!/usr/bin/env bash
set -euo pipefail

case "{{ .chezmoi.os }}" in
  darwin)
    if ! command -v brew >/dev/null 2>&1; then
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
      elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
      fi
    fi

    brew install \
      coreutils \
      fnm \
      git-lfs \
      gnu-sed \
      mosh \
      nginx \
      poppler \
      postgresql \
      redis

    brew install --cask \
      firefox \
      google-cloud-sdk \
      keycastr \
      nightfall \
      postgres-unofficial \
      spotify
    ;;
esac
{{ end }}