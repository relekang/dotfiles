#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: gh-resolve-review-thread THREAD_ID...

Resolve one or more GitHub pull request review threads.
THREAD_ID is the GraphQL node ID for a review thread, such as PRRT_....
EOF
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

if [[ $1 == "-h" || $1 == "--help" ]]; then
  usage
  exit 0
fi

query='mutation ResolveReviewThread($threadId: ID!) {
  resolveReviewThread(input: {threadId: $threadId}) {
    thread {
      id
      isResolved
    }
  }
}'

for thread_id in "$@"; do
  gh api graphql \
    -f "query=$query" \
    -f "threadId=$thread_id" \
    --jq '.data.resolveReviewThread.thread | "\(.id): resolved=\(.isResolved)"'
done
