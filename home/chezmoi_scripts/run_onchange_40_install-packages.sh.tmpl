{{ if has "packages" ((index .chezmoi "tags") | default (list)) }}#!/usr/bin/env bash
set -euo pipefail

case "{{ .chezmoi.os }}" in
  darwin)
    if ! command -v brew >/dev/null 2>&1; then
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
      elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
      fi
    fi

    brew install \
      coreutils \
      fnm \
      git-lfs \
      gnu-sed \
      mosh \
      nginx \
      poppler \
      postgresql \
      redis

    brew install --cask \
      firefox \
      google-cloud-sdk \
      keycastr \
      nightfall \
      postgres-unofficial \
      spotify
    ;;
  linux)
    if command -v apt-get >/dev/null 2>&1 && command -v dpkg-query >/dev/null 2>&1; then
      if ! dpkg-query -W -f='${Status}\n' mosh 2>/dev/null | grep -qx 'install ok installed'; then
        sudo apt-get update
        sudo apt-get install -y mosh
      fi
    elif command -v pacman >/dev/null 2>&1; then
      sudo pacman -S --needed --noconfirm \
        mosh \
        podman \
        podman-compose \
        spotifyd \
        playerctl \
        bind
    else
      echo "warning: no supported Linux package manager found" >&2
      exit 1
    fi

    if command -v ufw >/dev/null 2>&1; then
      sudo ufw allow 80/tcp comment 'http'
      sudo ufw allow 443/tcp comment 'https'
      sudo ufw allow 8000:8999/tcp comment 'devservers'
      if sudo LC_ALL=C ufw status | grep -qx 'Status: active'; then
        sudo ufw allow 60000:61000/udp comment 'mosh'
      fi
    fi
    ;;
esac
{{ end }}